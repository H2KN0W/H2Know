# H2KNOW web app - environment configuration
#
# Copy this file to `.env` (or `.env.local`) and fill in your Supabase values.
# Vite loads these at build time and exposes them via import.meta.env (VITE_ prefix).
#
# NEVER commit the real .env / .env.local - they are gitignored.

# Your Supabase project URL, e.g. https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_URL=

# The Supabase "publishable" (anon) key, safe for client-side use.
# Supabase Dashboard -> Project Settings -> API -> anon / publishable key.
VITE_SUPABASE_PUBLISHABLE_KEY=